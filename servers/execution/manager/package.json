{
  "name": "@into-cps-association/execution-manager",
  "version": "0.1.0",
  "description": "DTaaS execution manager microservice",
  "main": "dist/src/main.js",
  "repository": "https://github.com/into-cps-association/DTaaS.git",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "npx rimraf node_modules coverage dist src.svg test.svg",
    "check:final": "concurrently -s all -g -n syntax,format,graph,build,test \"yarn syntax\" \"yarn format\" \"yarn graph\" \"yarn build\" \"yarn test\"",
    "format": "prettier --ignore-path .gitignore --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --ignore-path .gitignore --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "graph": "npx madge --image src.svg src && npx madge --image test.svg test",
    "start": "npx cross-env NODE_OPTIONS=--experimental-specifier-resolution=node NODE_NO_WARNINGS=1 node dist/src/main.js",
    "syntax": "npx eslint . --fix",
    "syntax:check": "npx eslint .",
    "test": "npx cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage=true",
    "test:e2e": "npx cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage=true --verbose=true test/e2e",
    "test:nocov": "npx cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage=false",
    "test:unit": "npx cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage=true --verbose=true test/unit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "cross-env": "^10.1.0",
    "js-yaml": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@jest/globals": "^30.2.0",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.3.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "madge": "^8.0.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.3"
  }
}
